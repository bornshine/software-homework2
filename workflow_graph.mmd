---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	responder(responder)
	coder(coder)
	reviewer(reviewer)
	fixer(fixer)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	coder --> reviewer;
	fixer --> reviewer;
	reviewer -. &nbsp;give_up&nbsp; .-> __end__;
	reviewer -. &nbsp;fix&nbsp; .-> fixer;
	router -. &nbsp;code&nbsp; .-> coder;
	router -. &nbsp;chat&nbsp; .-> responder;
	responder --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
