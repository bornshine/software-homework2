# ============================================================
# 多 Agent 协作 Workflow 配置模板
# 复制本文件为 .env 并填入真实值
#
# 三个 Agent 各自独立配置：换成任何 OpenAI 兼容端点的模型都可以，
# 角色与模型解耦，改这里不需要改代码。
# ============================================================

# ---------- 编码 Agent（coder） ----------
CODER_LLM_API_KEY=your-coder-key-here
CODER_LLM_BASE_URL=https://api.deepseek.com/v1
CODER_LLM_MODEL=deepseek-v4.1-flash

# ---------- 审查 Agent（reviewer） ----------
REVIEWER_LLM_API_KEY=your-reviewer-key-here
REVIEWER_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
REVIEWER_LLM_MODEL=glm-5.3-flash

# ---------- 修复 Agent（fixer） ----------
FIXER_LLM_API_KEY=your-fixer-key-here
FIXER_LLM_BASE_URL=https://api.xiaomimimo.com/v1
FIXER_LLM_MODEL=mimo-v2.6-pro

# ---------- 对话 Agent（工作模式前台，可选） ----------
# 不填就复用上面的 FIXER_*（同一个 mimo 端点）。要单独指定再打开这三行：
# CHAT_LLM_API_KEY=your-mimo-key
# CHAT_LLM_BASE_URL=https://api.xiaomimimo.com/v1
# CHAT_LLM_MODEL=mimo-v2.6-pro
#
# 注意：模型名必须以端点 /models 返回的清单为准，名字不对会报 Unsupported model
# （例如小米端点只有 mimo-v2.5* / mimo-v2.6*，没有 xiaomi-v2.6-pro）

# ---------- 通用 LLM 参数（可选） ----------
LLM_TEMPERATURE=0.3
# 单次请求超时（秒）。推理模型很吃时间：实测 glm-5.3-flash 对一段 1.5KB
# 的审查提示要跑 121 秒（7130 reasoning tokens），设 60s 会直接被超时打断。
LLM_REQUEST_TIMEOUT=180

# SDK 层重试次数：保持 0。重试统一由节点层负责，
# 两层同时重试会相乘，导致一次卡死要等 3×3×60s 才报错。
LLM_HTTP_MAX_RETRIES=0

# ---------- 节点级韧性（可选） ----------
# 单次模型调用的最大尝试次数（含首次）
NODE_MAX_ATTEMPTS=3
# 重试退避：base * 2^(n-1)，并受 max 限制
NODE_RETRY_BASE_DELAY=0.6
NODE_RETRY_MAX_DELAY=5.0
# 工具调用的最大尝试次数（比模型调用保守）
TOOL_MAX_ATTEMPTS=2
# fixer 自验失败后，带错误反馈再修一次的次数
FIXER_SELF_REPAIR_ATTEMPTS=1

# ---------- Workflow 运行时（可选） ----------
# 单次 invoke 允许的最大图步数（防死循环）
AGENT_RECURSION_LIMIT=40
# 修复-复审最大循环次数（业务层兜底）
WORKFLOW_MAX_FIX_ROUNDS=3
# 阻断阈值：只有这些级别的问题才算"阻断问题"并触发修复循环。
# 其余级别（默认 info）仍会记录进 findings 与运行记录，但不阻止判定通过。
# 语义：通过 = 无阻断问题，不等于零建议。
WORKFLOW_BLOCKING_SEVERITIES=critical,warning
# 会话历史保留条数（超出时从最近的 HumanMessage 处截断）
AGENT_MAX_HISTORY_MESSAGES=40
# 运行记录 JSON 输出目录（支持 --resume 续跑）
RUN_RECORD_DIR=runs

# ---------- 受限执行沙箱（可选） ----------
# 留空表示用系统临时目录；某些受限环境下可指向工作区内目录
# EXEC_WORKDIR=./.sandbox
EXEC_TIMEOUT_SECONDS=10
EXEC_MAX_OUTPUT_CHARS=5000
EXEC_MAX_CODE_CHARS=20000
